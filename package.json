{
  "name": "field-and-farm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:workspace": "astro build --mode workspace",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run build && npm run build:workspace",
    "test:browser": "node scripts/browser-smoke.mjs",
    "audit:live": "node scripts/audit-live-preview.mjs",
    "audit:size": "node scripts/audit-size.mjs",
    "build:production": "node scripts/build-production.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "audit:performance": "node scripts/audit-performance.mjs",
    "audit:assets": "node scripts/audit-asset-provenance.mjs",
    "audit:game-fixtures": "node --experimental-strip-types scripts/verify-game-fixtures.mjs",
    "audit:reference": "node scripts/audit-reference-manifest.mjs"
  },
  "dependencies": {
    "astro": "7.4.13",
    "@astrojs/react": "7.1.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/node": "22.15.30",
    "playwright": "1.65.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
