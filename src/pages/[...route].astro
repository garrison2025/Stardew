---
import pages from '../config/pages.json';
import release from '../config/release.json';
import toolGuides from '../config/tool-guides.json';
import seoTasks from '../config/seo-task-links.json';
import geoAnswers from '../config/geo-answers.json';
import referenceManifest from '../config/reference-manifest.json';
import referencePack from '../config/reference-pack-lock.json';
import CropRoute from '../ui/CropRoute';
import TrackerRoute from '../ui/TrackerRoute';
import CollectionRoute from '../ui/CollectionRoute';
import {CATALOGS,type CatalogKind} from '../lib/game-collections';
import BundleRoute from '../ui/BundleRoute';
import MuseumRoute from '../ui/MuseumRoute';
import WalnutRoute from '../ui/WalnutRoute';
import PredictorRoute from '../ui/PredictorRoute';
import FairRoute from '../ui/FairRoute';
import GrandpaRoute from '../ui/GrandpaRoute';
import FarmCompareRoute from '../ui/FarmCompareRoute';
import SkillsRoute from '../ui/SkillsRoute';
import PerfectionRoute from '../ui/PerfectionRoute';
import FarmPlannerPage from '../ui/FarmPlannerPage';
import '../styles/global.css';
import '../styles/planner.css';
import '../styles/field-journal.css';
export function getStaticPaths(){return pages.map(page=>({params:{route:page.slug||undefined},props:{page}}))}
const {page}=Astro.props;
const guide=toolGuides[page.slug as keyof typeof toolGuides];
const nextTasks=seoTasks[page.slug as keyof typeof seoTasks];
const geo=geoAnswers[page.slug as keyof typeof geoAnswers];
const catalogue=['crafting','cooking','shipping','fishing'].includes(page.slug)?CATALOGS[page.slug as CatalogKind]:undefined;
const workspace=import.meta.env.MODE==='workspace';
const approvedPublic=!workspace&&import.meta.env.PUBLIC_APPROVED_RELEASE==='1'&&release.status==='production-approved'&&release.rightsApproved&&release.dataApproved&&release.fixturesApproved&&release.serpApproved&&page.releaseStatus==='approved'&&page.indexable;
function validOrigin(value:unknown){if(typeof value!=='string'||!value)return undefined;try{const u=new URL(value);return u.protocol==='https:'&&u.pathname==='/'&&!u.search&&!u.hash&&!u.username&&!u.password?u.origin:undefined}catch{return undefined}}
const publicOrigin=validOrigin(import.meta.env.PUBLIC_SITE_ORIGIN);
const workspaceOrigin=validOrigin(import.meta.env.PUBLIC_WORKSPACE_ORIGIN);
const workspaceUrl=!workspace&&workspaceOrigin&&workspaceOrigin!==publicOrigin?new URL(page.path,workspaceOrigin).href:undefined;
const revision=process.env.CF_PAGES_COMMIT_SHA||process.env.GITHUB_SHA||'';
const buildRevision=/^[0-9a-f]{40}$/i.test(revision)?revision:undefined;
const groups=['Plan','Calculate','Progress','Collect'];
const icons:Record<string,string>={'':'M3 3h18v18H3z M3 9h18M3 15h18M9 3v18M15 3v18','bundles':'M4 7h16v14H4zM3 3h18v4H3zM12 3v18M4 11h16','museum':'M3 8 12 3l9 5M3 21h18M5 10v9m7-9v9m7-9v9','predictor':'M12 2 14.5 9.5 22 12 14.5 14.5 12 22 9.5 14.5 2 12 9.5 9.5z','tracker':'M4 4h16v16H4zM7 15l3-4 3 2 4-6','crop-calculator':'M5 3h14v18H5zM8 7h8M8 11h2m4 0h2M8 15h2m4 0h2','fair-calculator':'M6 3h12v4c0 5-3 8-6 8S6 12 6 7zM6 5H3v3c0 3 2 4 4 4M18 5h3v3c0 3-2 4-4 4M12 15v4m-5 2h10','fishing':'M3 12c4-5 10-6 14 0l4-3v6l-4-3c-4 6-10 5-14 0zM7 11h.1','perfection':'M12 3 21 8v8l-9 5-9-5V8zM8 12l3 3 5-6','crafting':'M5 3h14v18H5zM8 8h8M8 12h8M8 16h5','shipping':'M3 7h18v14H3zM3 7l4-4h10l4 4M9 7v5h6V7','cooking':'M4 10h16v8H4zM2 13h2m16 0h2M8 3v4m4-4v4m4-4v4','golden-walnuts':'M12 3c5 0 8 5 8 9s-3 9-8 9-8-5-8-9 3-9 8-9zM12 3v18','farm-comparison':'M3 5h8v14H3zM14 5h7v14h-7z','grandpa-calculator':'M12 3 21 8v8l-9 5-9-5V8zM8 12h8M12 8v8','skills':'M4 20v-6h4v6M10 20V9h4v11M16 20V4h4v16'};
const short=(p:typeof page)=>p.h1.replace('Stardew Valley ','');
const selectedIcon=icons[page.slug]||icons[''];
const related=pages.filter(p=>p.path!==page.path && (page.relatedPaths||[]).includes(p.path));
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{page.title}</title><meta name="description" content={page.description}/>
<meta name="robots" content="noindex,nofollow"/>{buildRevision&&<meta name="build-revision" content={buildRevision}/>}
<meta name="theme-color" content="#fff9ef"/>
<meta property="og:title" content={page.title}/><meta property="og:description" content={page.description}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Field &amp; Farm"/><meta property="og:locale" content="en_US"/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={page.title}/><meta name="twitter:description" content={page.description}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
</head>
<body>
<a class="skip-link" href="#main">Skip to tool</a>
<div class:list={['journal-shell',page.slug===''?'journal-home':'']}>
<header class="journal-header">
 <div class="journal-nav">
  <a class="journal-brand" href="/"><span class="journal-brandmark" aria-hidden="true">✿</span><span>Field <i>&amp;</i> Farm</span></a>
  <nav aria-label="Main tools">
   {pages.filter(p=>['','crop-calculator','tracker'].includes(p.slug)).map(p=><a href={p.path} aria-current={p.path===page.path?'page':undefined}>{short(p)}</a>)}
  </nav>
  <div class="journal-actions">
   <details class="journal-directory"><summary>All tools <span aria-hidden="true">⌄</span></summary>
    <nav class="journal-directory-grid" aria-label="All tools">{groups.map(group=><div><strong>{group}</strong>{pages.filter(p=>p.group===group).map(p=><a href={p.path} aria-current={p.path===page.path?'page':undefined}>{short(p)}</a>)}</div>)}</nav>
   </details>
   <button class="tool-finder-trigger" type="button" hidden aria-haspopup="dialog" aria-controls="tool-finder" data-tool-finder-open aria-label="Find a tool"><span aria-hidden="true" class="journal-search-icon"></span><span>Find a tool</span><kbd aria-hidden="true">Ctrl K</kbd></button>
  </div>
 </div>
</header>
<main id="main" class:list={['journal-content',page.slug===''?'planner-page':'tool-page']}>
 <header class:list={['journal-intro', 'journal-'+page.group.toLowerCase()]}>
  <div class="journal-intro-copy">
   {page.slug!==''&&<p class="journal-crumb"><a href="/">Tools</a><span aria-hidden="true">/</span>{short(page)}</p>}
   <h1>{page.h1}</h1>
   <p>{page.description}</p>
  </div>
  <div class="journal-emblem" aria-hidden="true"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d={selectedIcon}/></svg></div>
 </header>
 <div class="journal-tool-meta">
  <span><i aria-hidden="true"></i>{workspace?'Private workspace':approvedPublic?'Public toolkit':'Development preview'}</span>
  {!workspace&&workspaceUrl&&<a href={workspaceUrl}>{page.slug?'Open private workspace':'Use my farm screenshot'} <span aria-hidden="true">↗</span></a>}
 </div>
{page.slug==='tracker'&&!workspace&&<section class="workspace-entry" aria-label="Private save workspace"><div><h2>Track your own farm</h2><p>Keep your save file on your device. Inspect supported fields and merge recognized collection progress in the separate private workspace.</p><small>{workspaceUrl?'No upload to our servers · no account · no ads':'Private workspace is not connected to this preview yet. Use the individual tools manually below.'}</small></div>{workspaceUrl&&<a href={workspaceUrl}>Open private save workspace</a>}</section>}
{page.slug===''&&<FarmPlannerPage workspace={workspace} client:load/>}
{page.slug==='crop-calculator'&&<CropRoute workspace={workspace} client:load/>}
{page.slug==='tracker'&&<TrackerRoute workspace={workspace} client:load/>}
{page.slug==='cooking'&&<CollectionRoute kind="cooking" workspace={workspace} client:load/>}
{page.slug==='crafting'&&<CollectionRoute kind="crafting" workspace={workspace} client:load/>}
{page.slug==='shipping'&&<CollectionRoute kind="shipping" workspace={workspace} client:load/>}
{page.slug==='fishing'&&<CollectionRoute kind="fishing" workspace={workspace} client:load/>}
{page.slug==='bundles'&&<BundleRoute workspace={workspace} client:load/>}
{page.slug==='museum'&&<MuseumRoute workspace={workspace} client:load/>}
{page.slug==='golden-walnuts'&&<WalnutRoute workspace={workspace} client:load/>}
{page.slug==='predictor'&&<PredictorRoute workspace={workspace} client:load/>}
{page.slug==='fair-calculator'&&<FairRoute workspace={workspace} client:load/>}
{page.slug==='grandpa-calculator'&&<GrandpaRoute workspace={workspace} client:load/>}
{page.slug==='farm-comparison'&&<FarmCompareRoute workspace={workspace} client:load/>}
{page.slug==='skills'&&<SkillsRoute workspace={workspace} client:load/>}
{page.slug==='perfection'&&<PerfectionRoute workspace={workspace} client:load/>}
<details class="journal-preview-note"><summary>{approvedPublic?'Data and limitations':'Preview data and limitations'}</summary><p>The planner includes eight pinned base terrain restriction references and eight independent practice scenes, all using original or credited free artwork. Game-derived reference flags and dynamic terrain compatibility have not been fully verified. Rules and game data may have incomplete coverage. Game version and tool-specific limitations appear in the tool guide.</p></details>
<div class="journal-reading">{catalogue&&<section class="guide"><details><summary>Complete reference catalogue ({catalogue.length} entries)</summary><p>All item names are searchable in the interactive planner above. This compact reference list does not record progress.</p><ul>{catalogue.map(item=><li><strong>{item.name}</strong>{item.ingredients?.length?` — ${item.ingredients.map(i=>`${i.quantity} × ${i.name}`).join(" · ")}`:""}{item.hint?` — ${item.hint}`:""}</li>)}</ul></details></section>}<section class="guide"><div class="guide-header"><h2>{page.guideTitle}</h2><p>{page.guideText}</p></div><div class="guide-steps">{guide.steps.map(([heading,body])=><div><h3>{heading}</h3><p>{body}</p></div>)}</div><div class="tool-example"><h3>Worked example</h3><p>{guide.example}</p></div><div class="tool-faq"><h3>Frequently asked questions</h3>{guide.faq.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div><details class="version-details"><summary>Game version &amp; preview limitations</summary><p>1.6: {release.adapters['1.6']}. 1.7: {release.adapters['1.7']}. {approvedPublic?'See the tool-specific supported version and limitations.':'Approved data and independent test fixtures are required before production release.'}</p></details></section>
<section id="tool-reference" class="guide" aria-labelledby="tool-reference-heading"><div class="guide-header"><h2 id="tool-reference-heading">{geo.question}</h2><p>{geo.answer}</p></div><div class="guide-steps"><div><h3>How this tool works</h3><p>{geo.method}</p></div><div><h3>What the result does not establish</h3><p>{geo.limit}</p></div></div><div class="tool-example"><h3>Reference sources and version</h3><p>Field &amp; Farm is an independent fan toolkit. Numerical reference: PC {referenceManifest.gameVersion}; reference pack: <code>{referencePack.id}</code>. The linked sources document game rules or upstream methods, not an endorsement or a license grant.</p><ul>{geo.sources.map(source=><li><a href={source.url}>{source.label}</a></li>)}</ul></div></section>
<section class="guide" aria-labelledby="next-task-heading"><div class="guide-header"><h2 id="next-task-heading">What to do next</h2></div><div class="guide-steps">{nextTasks.map(([heading,body,href])=><div><h3><a href={href}>{heading}</a></h3><p>{body}</p></div>)}</div></section>
<section class="related"><h2>Related tools</h2><div class="related-grid">{(related.length?related:pages.filter(p=>p.group===page.group&&p.slug!==page.slug)).map(p=><a href={p.path}><span class="related-icon"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d={icons[p.slug]||icons['']}/></svg></span><div><strong>{short(p)}</strong><small>{p.description}</small></div><span aria-hidden="true">↗</span></a>)}</div></section>
<footer><div>Field &amp; Farm · Independent fan-tool development project.</div><p>Stardew Valley belongs to ConcernedApe. This independent fan-tool is not affiliated with or endorsed by ConcernedApe. No original game artwork or third-party advertising scripts. <a href="/art/credits.html">Artwork credits</a> · <a href="/privacy/">Privacy</a> · <a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/terms/">Terms</a></p></footer>
</div></main></div>
<dialog id="tool-finder" class="tool-finder" aria-labelledby="tool-finder-heading">
  <div class="tool-finder-header">
    <h2 id="tool-finder-heading">Find a tool</h2>
    <form method="dialog"><button aria-label="Close tool search">×</button></form>
  </div>
  <label class="tool-finder-label" for="tool-finder-query">Search by tool or task</label>
  <input id="tool-finder-query" type="search" autocomplete="off" placeholder="Try crops, fishing or layout" autofocus />
  <p class="tool-finder-status" role="status"></p>
  <ul class="tool-finder-results">
    {pages.map(p=><li data-search={`${p.h1} ${p.path.replaceAll('-', ' ')} ${p.group} ${p.description} ${p.primaryKeyword} ${p.secondaryKeywords.join(" ")}`} data-search-aliases={p.searchAliases.join("|")}>
      <a href={p.path} aria-current={p.path===page.path?'page':undefined}>
        <span><strong>{short(p)}</strong><small>{p.description}</small></span>
        <span class="tool-finder-group">{p.group}</span>
      </a>
    </li>)}
  </ul>
</dialog>
<script is:inline src="/tool-finder.js" defer></script>
</body></html>
